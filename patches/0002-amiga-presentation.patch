+#ifdef __amigaos__
+// SetEnv RAPTOR_FPS 1: the frames shown every five seconds, on the Shell
+// (a file name instead of 1 adds the lines to that file)
+static void I_CountFrame(void)
+{
+    static int state = -1;
+    static FILE *log;
+    static Uint32 start;
+    static int frames;
+    Uint32 now;
+
+    if (state < 0)
+    {
+        const char *v = SDL_getenv("RAPTOR_FPS");
+
+        state = v != NULL && *v != '\0' && strcmp(v, "0") != 0;
+        if (state)
+        {
+            log = strcmp(v, "1") ? fopen(v, "a") : NULL;
+            if (log == NULL)
+                log = stdout;
+            start = SDL_GetTicks();
+        }
+    }
+    if (!state)
+        return;
+
+    frames++;
+    now = SDL_GetTicks();
+    if (now - start >= 5000)
+    {
+        fprintf(log, "fps: %d frames in %u ms, %.1f a second\n",
+                frames, (unsigned)(now - start), frames * 1000.0 / (now - start));
+        fflush(log);
+        frames = 0;
+        start = now;
+    }
+}
+#endif // __amigaos__
