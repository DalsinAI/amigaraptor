--- a/src/fx.cpp
+++ b/src/fx.cpp
@@ -57,6 +57,13 @@ char cards[M_LAST][23] = {
     "Sound Blaster AWE 32",
 };
 
+#ifdef __amigaos__
+// AmigaOS: the buffers mixed and the time spent mixing them, for the
+// RAPTOR_FPS lines (FX_TakeStats)
+static volatile Uint32 fx_buffers;
+static volatile Uint64 fx_mixticks;
+#endif // __amigaos__
+
 /***************************************************************************
 FX_Fill() -
  ***************************************************************************/
@@ -67,13 +74,47 @@ FX_Fill(
     int len
 )
 {
+#ifdef __amigaos__
+    Uint64 t0 = SDL_GetPerformanceCounter();
+#endif // __amigaos__
     memset(stream, 0, len);
     int16_t *stream16 = (int16_t*)stream;
     len /= 4;
     MUS_Mix(stream16, len);
     GSS_Mix(stream16, len);
     DSP_Mix(stream16, len);
+#ifdef __amigaos__
+    fx_mixticks += SDL_GetPerformanceCounter() - t0;
+    fx_buffers++;
+#endif // __amigaos__
+}
+
+#ifdef __amigaos__
+/***************************************************************************
+FX_TakeStats() - AmigaOS: buffers mixed and milliseconds spent mixing
+                 since the last call; 0 when no sound is open
+ ***************************************************************************/
+int
+FX_TakeStats(
+    unsigned *buffers,
+    unsigned *mix_ms
+)
+{
+    Uint64 ticks;
+
+    if (!fx_dev)
+        return 0;
+
+    SDL_LockAudioDevice(fx_dev);
+    *buffers = fx_buffers;
+    ticks = fx_mixticks;
+    fx_buffers = 0;
+    fx_mixticks = 0;
+    SDL_UnlockAudioDevice(fx_dev);
+    *mix_ms = (unsigned)(ticks * 1000 / SDL_GetPerformanceFrequency());
+    return 1;
 }
+#endif // __amigaos__
 
