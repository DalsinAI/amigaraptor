     }
 }
 
+#ifdef __amigaos__
+/*------------------------------------------------------------------------
+IPT_PadSteers() - AmigaOS: a pad's d-pad or stick is pushed and no
+                  steering key is held, so the pad moves the ship
+  ------------------------------------------------------------------------*/
+static int
+IPT_PadSteers(
+    void
+)
+{
+    if (KBD_Key(k_Up) || KBD_Key(k_Down) || KBD_Key(k_Left) || KBD_Key(k_Right))
+        return 0;
+
+    return JOY_GetButton(JOYUP) || JOY_GetButton(JOYDOWN) ||
+           JOY_GetButton(JOYLEFT) || JOY_GetButton(JOYRIGHT) ||
+           JOY_GetAxis(JOYSTICKX) || JOY_GetAxis(JOYSTICKY);
+}
+
+/*------------------------------------------------------------------------
+IPT_GetPadButtons() - AmigaOS: a pad's buttons alongside the keyboard
+                      (IPT_GetJoyStick's, without its steering)
+  ------------------------------------------------------------------------*/
+static void
+IPT_GetPadButtons(
+    void
+)
+{
+    if (JOY_GetMappedButton(FIRE))
+        buttons[0] = 1;
+
+    if (JOY_GetMappedButton(CHWEAPON))
+        buttons[1] = 1;
+
+    if (JOY_GetMappedButton(MEGABOMB))
+        buttons[2] = 1;
+
+    if (JOY_GetMappedButton(MEGAFIRE))
+        buttons[3] = 1;
+
+    if (JOY_GetAxis(JOYTRIGGERRIGHT) > 0)
+        buttons[0] = 1;
+    if (JOY_GetAxis(JOYTRIGGERLEFT) > 0)
+        buttons[1] = 1;
+    if (JOY_GetButton(JOYLEFTSHOULDER))
+        buttons[2] = 1;
+    if (JOY_GetButton(JOYRIGHTSHOULDER))
+        buttons[3] = 1;
+}
+#endif // __amigaos__
+
 /*------------------------------------------------------------------------
 IPT_GetKeyBoard (
   ------------------------------------------------------------------------*/
@@ -407,7 +457,18 @@ IPT_MovePlayer(
         {
         case I_KEYBOARD:
         default:
+#ifdef __amigaos__
+            // AmigaOS: the keyboard, and any joystick or pad with it
+            if (IPT_PadSteers())
+            {
+                IPT_GetJoyStick();
+                break;
+            }
+            IPT_GetKeyBoard();
+            IPT_GetPadButtons();
+#else
             IPT_GetKeyBoard();
+#endif // __amigaos__
             break;
         
         case I_JOYSTICK:
